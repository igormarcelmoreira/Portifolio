---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
---
<section class="about band wrap" id="about">
  <h2 class="h-section" data-split-lines>{t.about.title}</h2>

  <div class="about__grid">
    <div class="about__body">
      {t.about.body.map((p) => <p data-reveal>{p}</p>)}
      <p class="about__langs" data-reveal>{t.about.langs}</p>
    </div>

    <div class="about__cv">
      <ol class="timeline">
        {t.about.jobs.map((j) => (
          <li class="entry" data-reveal>
            <span class="entry__period">{j.period}</span>
            <div>
              <h3 class="entry__role">{j.role}</h3>
              <p class="entry__org">{j.company}</p>
              <p class="entry__body">{j.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <h3 class="about__sub" data-reveal>{t.about.eduTitle}</h3>
      <ol class="timeline">
        {t.about.edu.map((e) => (
          <li class="entry entry--compact" data-reveal>
            <span class="entry__period">{e.period}</span>
            <div>
              <h4 class="entry__role">{e.title}</h4>
              <p class="entry__org">{e.school}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 3rem 5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .about__body p { font-size: clamp(1.15rem, 1.5vw, 1.35rem); line-height: 1.5; max-width: 40ch; margin-bottom: 1.4rem; }
  .about__langs { color: var(--bone-dim); font-size: 1rem !important; }
  .timeline { list-style: none; border-top: 1px solid var(--line); margin-bottom: 3rem; }
  .entry {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .entry__period { font-size: 0.95rem; color: var(--bone-dim); font-variant-numeric: tabular-nums; }
  .entry__role { font-size: 1.25rem; font-weight: 600; line-height: 1.25; }
  .entry__org { color: var(--bone-dim); margin-top: 0.2rem; }
  .entry__body { margin-top: 0.8rem; max-width: 52ch; }
  .entry--compact .entry__role { font-size: 1.05rem; }
  .about__sub {
    font-family: var(--display); font-stretch: 62%; font-weight: 800; text-transform: uppercase;
    font-size: 2.2rem; margin-bottom: 1rem;
  }
  @media (max-width: 860px) {
    .about__grid { grid-template-columns: 1fr; }
    .entry { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
