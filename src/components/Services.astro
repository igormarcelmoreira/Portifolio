---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
---
<section class="services band wrap" id="services">
  <div class="services__head">
    <h2 class="h-section" data-split-lines>{t.services.title}</h2>
    <p class="lead" data-reveal>{t.services.lead}</p>
  </div>

  <ul class="services__list">
    {t.services.items.map((s) => (
      <li class="service" data-service>
        <span class="service__rule" aria-hidden="true"></span>
        <h3 class="service__title">{s.title}</h3>
        <div class="service__body">
          <p>{s.body}</p>
          <ul class="service__tags">{s.tags.map((tag) => <li>{tag}</li>)}</ul>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem 4rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .services__list { list-style: none; }
  .service {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
  }
  .service__rule {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: var(--bone);
    transform-origin: left;
  }
  .service:last-child { border-bottom: 1px solid var(--line); }
  .service__title {
    font-family: var(--display);
    font-stretch: 62%;
    font-weight: 800;
    font-size: clamp(2.4rem, 5.5vw, 5rem);
    line-height: 0.9;
    text-transform: uppercase;
    transition: transform 0.6s var(--ease-out);
  }
  .service:hover .service__title { transform: translateX(0.4em); }
  .service__body p { font-size: 1.15rem; line-height: 1.5; max-width: 40ch; margin-bottom: 1.25rem; }
  .service__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .service__tags li {
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--bone-dim);
  }

  @media (max-width: 820px) {
    .services__head, .service { grid-template-columns: 1fr; }
  }
</style>
