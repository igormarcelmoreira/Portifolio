---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
---
<section class="contact wrap" id="contact">
  <h2 class="contact__title display" data-split-chars>{t.contact.title}</h2>

  <div class="contact__grid">
    <p class="contact__body" data-reveal>{t.contact.body}</p>
    <div class="contact__actions" data-reveal>
      <a class="contact__email" href={`mailto:${t.contact.email}`} data-magnetic>
        <span>{t.contact.email}</span>
      </a>
      <ul class="contact__links">
        <li><a class="u-link" href="https://wa.me/5551995816448" target="_blank" rel="noopener">{t.contact.whatsapp}</a></li>
        <li><a class="u-link" href="https://www.linkedin.com/in/igormarcelmoreira" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a class="u-link" href="https://github.com/igormarcelmoreira" target="_blank" rel="noopener">GitHub</a></li>
        <li><a class="u-link" href="https://www.instagram.com/igormarcel.dev" target="_blank" rel="noopener">Instagram</a></li>
      </ul>
    </div>
  </div>

  <footer class="foot">
    <span>{t.contact.rights}</span>
    <span>{t.nav.city} <time data-clock>--:--</time></span>
    <span>{t.contact.built}</span>
    <a class="u-link" href="#top" data-scroll>{t.contact.top}</a>
  </footer>
</section>

<style>
  .contact {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-top: clamp(7rem, 14vw, 12rem);
    background: var(--ink);
  }
  .contact__title { font-size: clamp(4.5rem, 14vw, 15rem); }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 2.5rem 4rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }
  .contact__body { font-size: clamp(1.2rem, 1.8vw, 1.6rem); line-height: 1.35; max-width: 26ch; color: var(--bone-dim); }
  .contact__email {
    display: inline-flex;
    padding: 1.4rem 2.2rem;
    border-radius: 999px;
    background: var(--blood);
    font-family: var(--display);
    font-stretch: 75%;
    font-weight: 700;
    font-size: clamp(1.4rem, 3vw, 2.6rem);
    transition: background 0.4s var(--ease-out), color 0.4s var(--ease-out);
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .contact__email:hover { background: var(--bone); color: var(--ink); }
  .contact__links { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 2rem; font-size: 1.1rem; }
  .foot {
    margin-top: auto;
    padding-block: 2rem;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem;
    font-size: 0.9rem; color: var(--bone-dim);
    border-top: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
  }
  .foot { margin-top: clamp(5rem, 10vw, 9rem); }
  @media (max-width: 820px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
