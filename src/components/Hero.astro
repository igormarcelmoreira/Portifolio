---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
---
<section class="hero" id="top">
  <div class="hero__portrait" data-hero-fade>
    <div data-speed="0.82">
      <pre class="hero__ascii" id="hero-ascii" aria-hidden="true"></pre>
    </div>
    <!-- iOS only: motion sensors need a tap before Safari hands them out (portrait.ts un-hides this) -->
    <button class="hero__tilt" type="button" data-tilt hidden>
      <span class="hero__tilt-phone" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="6.5" y="2" width="11" height="20" rx="2.5" /><path d="M11 18.5h2" /></svg>
      </span>
      {t.hero.tilt}
    </button>
  </div>

  <div class="hero__meta wrap">
    <p class="hero__intro" data-hero-fade>{t.hero.intro}</p>
    <div class="hero__actions" data-hero-fade>
      <p class="hero__status"><span class="hero__live" aria-hidden="true"></span>{t.hero.status}</p>
      <a class="pill" href="#contact" data-scroll><span class="dot" aria-hidden="true"></span>{t.hero.cta}</a>
    </div>
  </div>

  <h1 class="hero__name display" data-hero-name>Igor Marcel</h1>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
  }
  .hero__portrait {
    position: absolute;
    right: var(--gutter);
    bottom: 10.5vw;
    width: min(40vw, calc(100svh - 10.5vw - 6.5rem), 600px);
    z-index: 0;
  }
  .hero__ascii {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--ink);
    font-size: clamp(1.2px, 0.26vw, 2.3px);
    line-height: 1.1;
    white-space: pre;
    user-select: none;
  }
  .hero__ascii.is-3d { display: none; }
  .hero__tilt {
    position: absolute;
    top: 0.5rem;
    right: 0;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem 0.5rem 0.75rem;
    border-radius: 999px;
    background: var(--bone);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
    animation: tilt-ring 2s ease-out infinite;
  }
  .hero__tilt[hidden] { display: none; }
  .hero__tilt-phone { display: flex; }
  .hero__tilt-phone svg {
    width: 16px;
    height: 16px;
    transform-origin: 50% 80%;
    animation: tilt-rock 1.6s ease-in-out infinite;
  }
  /* a ring pulses out of the button while the phone glyph rocks: "tap me, then tilt" */
  @keyframes tilt-ring {
    0% { box-shadow: 0 0 0 0 rgba(241, 236, 230, 0.75); }
    70%, 100% { box-shadow: 0 0 0 0.9rem rgba(241, 236, 230, 0); }
  }
  @keyframes tilt-rock {
    0%, 100% { transform: rotate(-18deg); }
    50% { transform: rotate(18deg); }
  }
  :global(.hero__canvas) { width: 100%; }

  .hero__meta {
    position: absolute;
    left: 0;
    bottom: calc(16.5vw + 1.5rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: min(38rem, 48vw);
  }
  .hero__intro {
    font-size: clamp(1.35rem, 2.3vw, 2.1rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .hero__status { display: flex; align-items: center; gap: 0.6rem; font-size: 0.95rem; }
  .hero__live {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: var(--bone);
    animation: live 2.4s infinite;
  }
  @keyframes live {
    0% { box-shadow: 0 0 0 0 rgba(241, 236, 230, 0.6); }
    70%, 100% { box-shadow: 0 0 0 0.6rem rgba(241, 236, 230, 0); }
  }

  .hero__name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.085em;
    z-index: 1;
    font-size: 19.2vw;
    white-space: nowrap;
    padding-inline: calc(var(--gutter) * 0.5);
    color: var(--bone);
  }

  /* phones: the whole hero fits one screen. Text and name keep their size; the portrait
     takes whatever height is left (big on tall phones, smaller on short ones). */
  @media (max-width: 760px) {
    .hero {
      height: 100svh;
      min-height: 560px; /* tiny screens scroll rather than crush the portrait */
      display: flex;
      flex-direction: column;
      padding-top: 4.25rem;
    }
    .hero__portrait {
      position: relative;
      right: auto;
      bottom: auto;
      flex: 1 1 0;
      min-height: 0;
      width: 100%;
    }
    .hero__portrait > [data-speed] { height: 100%; }
    .hero__portrait :global(.hero__canvas) { width: 100%; height: 100%; aspect-ratio: auto !important; }
    .hero__ascii { height: 100%; overflow: hidden; display: flex; justify-content: center; }
    .hero__tilt { right: var(--gutter); }
    .hero__meta {
      position: relative;
      bottom: auto;
      flex: 0 0 auto;
      max-width: none;
      padding-block: 1rem 0.9rem;
      gap: 1.1rem;
    }
    .hero__intro { font-size: 1.25rem; }
    .hero__name { position: relative; bottom: auto; flex: 0 0 auto; margin-bottom: -0.085em; }
  }
</style>
